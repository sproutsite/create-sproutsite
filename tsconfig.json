{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
